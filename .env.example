# CodeAssistAI environment configuration
# Copy to .env and adjust as needed. Never commit real secrets.

# Application
APP_NAME=codeassistai
APP_VERSION=1.0.0
LOG_LEVEL=INFO

# Provider: mock | transformer | external
PROVIDER=mock

# Request limits
MAX_CODE_LENGTH=50000

# Transformer (Hugging Face) — CPU-friendly default; only used when PROVIDER=transformer
TRANSFORMER_MODEL_NAME=Salesforce/codegen-350M-mono
TRANSFORMER_MAX_NEW_TOKENS=512
TRANSFORMER_TEMPERATURE=0.2
TRANSFORMER_DEVICE=cpu

# External LLM (OpenAI-compatible) — only used when PROVIDER=external
EXTERNAL_LLM_API_KEY=
EXTERNAL_LLM_BASE_URL=https://api.openai.com/v1
EXTERNAL_LLM_MODEL=gpt-4o-mini
EXTERNAL_LLM_TIMEOUT_SECONDS=60
